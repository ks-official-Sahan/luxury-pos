{
  "name": "@luxury-pos/pos",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "Universal POS client: iOS, Android and web from one Expo codebase; the web build also powers the Electron desktop app.",
  "scripts": {
    "dev": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.10",
    "@luxury-pos/contracts": "workspace:*",
    "@luxury-pos/core": "workspace:*",
    "@luxury-pos/theme": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sahan-sac/analytics-kit": "^0.2.0",
    "@sahan-sac/auth-kit-client": "^0.1.0",
    "@tanstack/react-query": "^5.104.4",
    "better-auth": "^1.7.10",
    "expo": "~58.0.14",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.13",
    "expo-network": "~58.0.3",
    "expo-router": "~58.0.23",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "phosphor-react-native": "^3.0.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.0",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": { "@types/react": "~19.3.0", "typescript": "^5.9.3" }
}
