{
  "name": "@luxury-pos/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Windows, macOS and Linux till: the Expo web build in a hardened Electron shell with receipt printing.",
  "main": "src/main.mjs",
  "scripts": {
    "bundle:web": "cd ../pos && EXPO_PUBLIC_API_URL=https://pos.local expo export --platform web --output-dir ../desktop/web",
    "dev": "electron .",
    "dist": "pnpm bundle:web && electron-builder --publish never",
    "dist:win": "pnpm bundle:web && electron-builder --win --publish never",
    "dist:mac": "pnpm bundle:web && electron-builder --mac --publish never",
    "dist:linux": "pnpm bundle:web && electron-builder --linux --publish never"
  },
  "devDependencies": { "electron": "^45.0.0", "electron-builder": "^26.18.0" },
  "build": {
    "appId": "com.luxurypos.desktop",
    "productName": "Luxury POS",
    "files": ["src/**", "web/**", "package.json"],
    "mac": { "category": "public.app-category.business", "target": ["dmg", "zip"], "hardenedRuntime": true },
    "win": { "target": ["nsis"] },
    "linux": { "target": ["AppImage", "deb"], "category": "Office" }
  }
}
