NODE_ENV=development
PORT=8787
# Pooled URL in production (Neon pooler / PgBouncer). Connect as a NON-superuser role so RLS applies.
DATABASE_URL=postgres://app_user:app@localhost:5432/luxury_pos
# openssl rand -base64 48
AUTH_SECRET=
SITE_URL=http://localhost:8787
# Extra web origins, e.g. the desktop app and preview deploys
APP_ORIGINS=https://pos.local
NATIVE_ORIGINS=luxurypos://
# Optional: serve the exported web app from the API origin
# WEB_DIST=../pos/dist

# Upstash Redis — required with more than one API instance (rate limits, session cache)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# AI insights (@sahan-sac/ai-core) — free providers first
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# AI_ALLOW_PAID=false

# Email (@sahan-sac/email-kit)
# EMAIL_PROVIDER=auto
# RESEND_API_KEY=
# RESEND_SENDER_EMAIL=
# BREVO_API_KEY=

# Media (@sahan-sac/media-kit)
# CLOUDINARY_URL=
# MEDIA_SIGNING_SECRET=
