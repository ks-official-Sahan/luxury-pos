# Copy to .env.docker (gitignored), then: docker compose --env-file .env.docker up -d --build
# Empty or unset values fall back to the dev-only defaults in docker-compose.yml.
# Replace every *_dev_only value and AUTH_SECRET outside local dev.
NODE_ENV=production
AUTH_SECRET=change-me-to-at-least-32-random-characters
SITE_URL=http://localhost:8080
APP_ORIGINS=http://localhost:8080
NATIVE_ORIGINS=
TRUSTED_PROXY_HOPS=1

# Must match infra/postgres/init.sql (only applied on an empty pgdata volume).
POS_DB_PASSWORD=pos_dev_only
APP_DB_PASSWORD=app_dev_only

REDIS_HTTP_TOKEN=local-dev-token

# events profile: KAFKA_BROKERS=redpanda:9092
KAFKA_BROKERS=
KAFKA_CLIENT_ID=luxury-pos-api
EVENTS_TOPIC_PREFIX=luxury-pos

# ops profile
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
AGE_RECIPIENT=
BACKUP_S3_URI=
BACKUP_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
