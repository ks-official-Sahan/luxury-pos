{
  "name": "@luxury-pos/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zod request/response contracts shared by the API, the apps and the MCP server.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./openapi": {
      "types": "./src/openapi.ts",
      "default": "./src/openapi.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "openapi": "tsx scripts/openapi.ts"
  },
  "dependencies": {
    "zod": "^4.6.7",
    "@luxury-pos/core": "workspace:*",
    "@luxury-pos/theme": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "tsx": "^4.23.15"
  }
}
